---
import LanguageSwitcher from './LanguageSwitcher.astro';
const { locale, dict } = Astro.props;
const links = [
  ['/', dict.nav.home],
  ['/about', dict.nav.about],
  ['/programs', dict.nav.programs],
  ['/media', dict.nav.media],
  ['/contact', dict.nav.contact]
];
const current = Astro.url.pathname.replace(/^\/(my|th)/, '') || '/';
const isHome = current === '/';
const localize = (href: string) => (locale === 'en' ? href : `/${locale}${href === '/' ? '' : href}`);
---
<header
  id="site-nav"
  data-home={isHome ? 'true' : 'false'}
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color,box-shadow,backdrop-filter] duration-500"
>
  <nav class="shell flex items-center justify-between gap-3 py-3 sm:py-3.5" aria-label="Primary navigation">
    <a href={localize('/')} class="group flex min-w-0 items-center gap-2.5 sm:gap-3">
      <span class="relative grid h-10 w-10 shrink-0 place-items-center sm:h-11 sm:w-11">
        <span class="absolute inset-0 rounded-full bg-dawn opacity-0 blur-md transition-opacity duration-500 group-hover:opacity-60"></span>
        <img src="/Sunrise_logo.jpg" alt="" class="relative h-10 w-10 rounded-full ring-1 ring-line-strong sm:h-11 sm:w-11" loading="eager" />
      </span>
      <span class="flex min-w-0 flex-col leading-none">
        <span class="nav-brand font-display text-[1.25rem] font-semibold tracking-tight text-ink sm:text-[1.35rem]">Sunrise</span>
        <span class="nav-sub mt-0.5 hidden text-[0.6rem] font-bold uppercase tracking-eyebrow text-ink-muted min-[380px]:block">Trauma Healing · GED</span>
      </span>
    </a>

    <div class="hidden items-center gap-8 lg:flex">
      {links.map(([href, label]) => (
        <a
          href={localize(href)}
          class:list={[
            'nav-link link-underline text-[0.92rem] font-medium transition-colors duration-300',
            current === href ? 'is-active text-ember' : 'text-ink-soft hover:text-ink'
          ]}
        >
          {label}
        </a>
      ))}
    </div>

    <div class="hidden items-center gap-3 lg:flex">
      <LanguageSwitcher locale={locale} label={dict.common.switchLanguage} />
      <a href={localize('/enroll')} class="btn btn-primary !px-5 !py-2.5 text-sm">{dict.hero.enrollCTA}</a>
    </div>

    <button
      id="menu-button"
      class="nav-burger grid h-11 w-11 shrink-0 place-items-center rounded-full border border-line-strong text-ink transition-colors hover:bg-ink/5 lg:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="icon-open" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg class="icon-close" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="mobile-menu border-t border-transparent bg-paper/95 backdrop-blur-xl lg:hidden">
    <div class="shell grid gap-1 py-5">
      {links.map(([href, label], i) => (
        <a
          href={localize(href)}
          style={`--i:${i}`}
          class:list={['m-link rounded-xl px-4 py-3.5 text-base font-medium transition-colors', current === href ? 'bg-sun/10 text-ember' : 'text-ink-soft hover:bg-ink/5 active:bg-ink/5']}
        >
          {label}
        </a>
      ))}
      <div class="m-link mt-3 flex items-center justify-between gap-3 border-t border-line pt-4" style={`--i:${links.length}`}>
        <LanguageSwitcher locale={locale} label={dict.common.switchLanguage} />
        <a href={localize('/enroll')} class="btn btn-primary !px-5 !py-2.5 text-sm">{dict.hero.enrollCTA}</a>
      </div>
    </div>
  </div>
</header>
<script>
  const nav = document.getElementById('site-nav');
  const button = document.getElementById('menu-button');
  const menu = document.getElementById('mobile-menu');

  const isOpen = () => menu?.classList.contains('is-open') ?? false;
  const isHome = nav?.dataset.home === 'true';

  const setNav = () => {
    if (!nav) return;
    const solid = window.scrollY > 16 || isOpen();
    nav.classList.toggle('bg-paper/80', solid);
    nav.classList.toggle('backdrop-blur-xl', solid);
    nav.classList.toggle('border-line', solid);
    nav.classList.toggle('shadow-warm', solid);
    // Over the dark photo hero (home, before scroll) → light nav text
    nav.classList.toggle('nav-over-dark', isHome && !solid);
  };

  const closeMenu = () => {
    menu?.classList.remove('is-open');
    button?.classList.remove('is-open');
    button?.setAttribute('aria-expanded', 'false');
    button?.setAttribute('aria-label', 'Open menu');
    document.body.classList.remove('menu-open');
    setNav();
  };

  const openMenu = () => {
    menu?.classList.add('is-open');
    button?.classList.add('is-open');
    button?.setAttribute('aria-expanded', 'true');
    button?.setAttribute('aria-label', 'Close menu');
    document.body.classList.add('menu-open');
    setNav();
  };

  setNav();
  window.addEventListener('scroll', setNav, { passive: true });

  button?.addEventListener('click', () => (isOpen() ? closeMenu() : openMenu()));

  // Close after tapping a link, on Escape, and when growing to desktop width
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && isOpen() && closeMenu());
  const mq = window.matchMedia('(min-width: 1024px)');
  mq.addEventListener('change', (e) => e.matches && closeMenu());
</script>
