---
const { current = '' } = Astro.props as { current?: string };
const links = [
  { href: '/admin', label: 'Dashboard', icon: 'M3 3h8v8H3zM13 3h8v5h-8zM13 12h8v9h-8zM3 13h8v8H3z' },
  { href: '/admin/posts', label: 'Posts', icon: 'M14 3v4a1 1 0 0 0 1 1h4M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM8 13h8M8 17h6' },
  { href: '/admin/enrollments', label: 'Enrollments', icon: 'M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M9 5a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2M9 13l2 2 4-4' },
  { href: '/admin/media', label: 'Media', icon: 'M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2zM3 16l5-5 4 4 3-3 6 6M8.5 9.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z' },
  { href: '/admin/users', label: 'Users', icon: 'M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm7 0a3 3 0 1 0 0-6M3 20a6 6 0 0 1 12 0M15 14.5a6 6 0 0 1 6 5.5' },
  { href: '/admin/settings', label: 'Settings', icon: 'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z' }
];
const isActive = (href: string) => (href === '/admin' ? current === '/admin' || current === '/admin/' : current.startsWith(href));
---
<div id="admin-overlay" class="pointer-events-none fixed inset-0 z-40 bg-ink/50 opacity-0 backdrop-blur-sm transition-opacity duration-300 lg:hidden"></div>

<aside id="admin-sidebar" class="fixed inset-y-0 left-0 z-50 flex w-[17rem] -translate-x-full flex-col bg-espresso text-paper transition-transform duration-300 ease-dawn lg:translate-x-0">
  <a href="/admin" class="flex items-center gap-3 border-b border-white/10 px-6 py-[1.15rem]">
    <img src="/Sunrise_logo.jpg" alt="" class="h-11 w-11 shrink-0 rounded-full ring-1 ring-white/15" />
    <span class="flex min-w-0 flex-col leading-none">
      <span class="font-display text-xl font-semibold">Sunrise</span>
      <span class="mt-1 text-[0.6rem] font-bold uppercase tracking-eyebrow text-sun">Admin Console</span>
    </span>
  </a>

  <nav class="flex-1 space-y-1 overflow-y-auto px-3 py-5">
    {links.map((l) => (
      <a
        href={l.href}
        class:list={[
          'group relative flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm font-medium transition-colors duration-200',
          isActive(l.href) ? 'bg-white/10 text-paper' : 'text-paper/60 hover:bg-white/5 hover:text-paper'
        ]}
        aria-current={isActive(l.href) ? 'page' : undefined}
      >
        {isActive(l.href) && <span class="absolute left-0 top-1/2 h-5 w-1 -translate-y-1/2 rounded-r-full bg-dawn"></span>}
        <svg class:list={['h-5 w-5 shrink-0 transition-colors', isActive(l.href) ? 'text-sun' : 'text-paper/45 group-hover:text-paper/80']} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={l.icon} /></svg>
        {l.label}
      </a>
    ))}
  </nav>

  <div class="border-t border-white/10 p-3">
    <button id="admin-logout" class="flex w-full items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm font-medium text-paper/60 transition-colors hover:bg-white/5 hover:text-paper">
      <svg class="h-5 w-5 text-paper/45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" /></svg>
      Sign out
    </button>
  </div>
</aside>

<script>
  document.getElementById('admin-logout')?.addEventListener('click', async () => {
    try { await fetch('/api/auth/logout', { method: 'POST' }); } catch {}
    try { localStorage.removeItem('sunrise_token'); } catch {}
    window.location.href = '/admin/login';
  });
</script>
