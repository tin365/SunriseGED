---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../ContactForm';
import { t, type Locale } from '../../lib/i18n';
const { locale = 'en' } = Astro.props as { locale: Locale };
const dict = t(locale);
---
<BaseLayout title={dict.contact.title} description="Contact Sunrise GED in Mae Sot, Thailand.">
  <section class="relative overflow-hidden bg-paper pb-10 pt-36" style="background: linear-gradient(180deg, #FCE8CD 0%, #FBF6EE 70%);">
    <div class="bloom pointer-events-none absolute -top-20 left-1/2 h-[36rem] w-[60rem] max-w-[140vw] -translate-x-1/2 opacity-60"></div>
    <div class="shell relative">
      <p class="eyebrow" data-reveal>Get in touch</p>
      <h1 class="font-display mt-5 text-[clamp(2.6rem,6vw,4.5rem)] font-semibold leading-[1.05] tracking-tight text-ink" data-reveal style="--reveal-delay:100ms">{dict.contact.title}</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft" data-reveal style="--reveal-delay:200ms">We reply within 2–3 business days. For quick questions, message us on Messenger or Line.</p>
    </div>
  </section>

  <section class="section bg-paper pt-12">
    <div class="shell grid gap-10 lg:grid-cols-2 lg:gap-14">
      <div class="space-y-6" data-reveal="left">
        <div class="card p-7">
          <span class="grid h-12 w-12 place-items-center rounded-2xl bg-sun/12 text-ember"><svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 21s-7-5.5-7-11a7 7 0 1 1 14 0c0 5.5-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg></span>
          <h2 class="font-display mt-5 text-2xl font-semibold text-ink">{dict.contact.address}</h2>
          <p class="mt-3 leading-relaxed text-ink-soft">{dict.contact.addressValue}</p>
          <p class="mt-2 text-sm text-ink-muted">Business hours: Monday–Friday, 9:00–17:00</p>
        </div>
        <iframe title="Mae Sot map" src="https://maps.google.com/maps?q=Mae+Sot,Thailand&output=embed" class="h-72 w-full rounded-card border border-line shadow-warm" loading="lazy"></iframe>
        <div class="card p-7">
          <h2 class="font-display text-2xl font-semibold text-ink">{dict.contact.chatWithUs}</h2>
          <div class="mt-5 flex flex-wrap gap-3">
            <a href="https://m.me/sunrisetraumahealingeducation" class="inline-flex items-center gap-2 rounded-full bg-[#1877F2] px-5 py-3 text-sm font-semibold text-white transition hover:opacity-90">{dict.contact.messenger}</a>
            <a href="https://line.me/R/ti/p/@YOUR_LINE_OFFICIAL_ID" class="inline-flex items-center gap-2 rounded-full bg-[#06C755] px-5 py-3 text-sm font-semibold text-white transition hover:opacity-90">{dict.contact.line}</a>
            <a href="https://facebook.com/sunrisetraumahealingeducation" class="inline-flex items-center gap-2 rounded-full border border-line-strong px-5 py-3 text-sm font-semibold text-ink-soft transition hover:border-ink hover:text-ink">Facebook</a>
          </div>
        </div>
      </div>
      <div data-reveal="right">
        <ContactForm dict={dict} locale={locale} client:load />
      </div>
    </div>
  </section>
</BaseLayout>
