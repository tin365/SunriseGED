---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import MessengerChat from '../components/MessengerChat.astro';
import LineChat from '../components/LineChat.astro';
import { getLangFromUrl, t } from '../lib/i18n';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const locale = getLangFromUrl(Astro.url.pathname);
const dict = t(locale);
const title = Astro.props.title ? `${Astro.props.title} | Sunrise GED` : 'Sunrise Trauma Healing Education';
const description = Astro.props.description || dict.hero.subtitle;
const canonical = new URL(Astro.url.pathname, Astro.site || 'https://sunrisegeded.org').toString();
const orgJson = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  name: 'Sunrise Trauma Healing Education',
  alternateName: ['Sunrise GED', 'Sunrise The Trauma Healing Program'],
  url: 'https://sunrisegeded.org',
  logo: 'https://sunrisegeded.org/Sunrise_logo.jpg',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Mae Sot',
    addressRegion: 'Tak Province',
    postalCode: '63110',
    addressCountry: 'TH'
  },
  sameAs: ['https://facebook.com/sunrisetraumahealingeducation']
};
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#FBF6EE" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..900;1,9..144,400..600&family=Hanken+Grotesk:wght@400;500;600;700;800&family=Noto+Sans+Myanmar:wght@400;600;700&family=Noto+Sans+Thai:wght@400;600;700&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og-image.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/og-image.jpg" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(orgJson)} />
  </head>
  <body class="bg-paper font-sans text-ink antialiased selection:bg-ink">
    <div class="grain" aria-hidden="true"></div>
    <Nav locale={locale} dict={dict} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} dict={dict} />
    <MessengerChat />
    <LineChat />
    <script is:inline>
      (() => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const reveal = () => {
          const items = document.querySelectorAll('[data-reveal]');
          if (reduce || !('IntersectionObserver' in window)) {
            items.forEach((el) => el.classList.add('is-visible'));
            return;
          }
          const io = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
          items.forEach((el) => io.observe(el));
        };

        // Animated count-up for [data-count] elements
        const counters = () => {
          const nums = document.querySelectorAll('[data-count]');
          if (reduce || !('IntersectionObserver' in window)) {
            nums.forEach((el) => (el.textContent = el.getAttribute('data-count')));
            return;
          }
          const io = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target;
              const target = parseFloat(el.getAttribute('data-count'));
              const suffix = el.getAttribute('data-suffix') || '';
              const start = performance.now();
              const dur = 1500;
              const tick = (now) => {
                const p = Math.min((now - start) / dur, 1);
                const eased = 1 - Math.pow(1 - p, 3);
                el.textContent = Math.round(target * eased) + suffix;
                if (p < 1) requestAnimationFrame(tick);
              };
              requestAnimationFrame(tick);
              io.unobserve(el);
            });
          }, { threshold: 0.6 });
          nums.forEach((el) => io.observe(el));
        };

        const run = () => { reveal(); counters(); };
        if (document.readyState !== 'loading') run();
        else document.addEventListener('DOMContentLoaded', run);
      })();
    </script>
  </body>
</html>
