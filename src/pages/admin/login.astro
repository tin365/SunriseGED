---
import LoginForm from '../../components/admin/LoginForm';
import '../../styles/global.css';
export const prerender = false;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login | Sunrise Admin</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..900&family=Hanken+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="grid min-h-screen place-items-center px-4 font-sans text-ink antialiased" style="background: radial-gradient(120% 90% at 50% -10%, #FCE8CD 0%, #FBF6EE 55%, #F2E7D5 100%);">
    <main class="w-full max-w-sm py-10">
      <div class="flex flex-col items-center text-center">
        <img src="/Sunrise_logo.jpg" alt="Sunrise" class="h-20 w-20 rounded-full shadow-lift ring-1 ring-line-strong" />
        <p class="eyebrow is-centered mt-6">Admin Console</p>
        <h1 class="mt-3 font-display text-3xl font-semibold text-ink">Welcome back</h1>
        <p class="mt-2 text-sm text-ink-soft">Sign in to manage Sunrise GED.</p>
      </div>
      <div class="mt-7">
        <LoginForm client:load />
      </div>
      <p class="mt-6 text-center text-xs text-ink-muted">Protected area · Sunrise Trauma Healing Education</p>
    </main>
  </body>
</html>
